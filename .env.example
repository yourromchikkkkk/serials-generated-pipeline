# Copy to .env and fill in real values. Never commit the real .env file.

# --- LiteLLM proxy (container) ---
LITELLM_MASTER_KEY=sk-changeme
LITELLM_API_BASE=http://localhost:4000

# --- LLM provider keys (consumed by the LiteLLM proxy) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- fal.ai (video / voice / lip-sync / image generation) ---
FAL_KEY=

# --- LangSmith (observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=serials-generated-pipeline

# --- Queue / cache (per-shot parallelism) ---
REDIS_URL=redis://localhost:6379/0
