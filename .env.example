# Copy to .env and fill in real values. Never commit the real .env file.

# --- LiteLLM proxy (container) ---
LITELLM_MASTER_KEY=sk-changeme
LITELLM_API_BASE=http://localhost:4000

# --- LLM provider keys (consumed by the LiteLLM proxy) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM models per pipeline stage (must match a model_name in config/litellm/config.yaml) ---
SCRIPT_ENHANCER_MODEL=anthropic/claude-haiku
TARANTINO_MODEL=anthropic/claude-haiku
SHOT_LIST_GENERATION_MODEL=anthropic/claude-haiku

# --- fal.ai (video / voice / lip-sync / image generation) ---
FAL_KEY=

# --- LangSmith (observability) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=serials-generated-pipeline
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Queue / cache (per-shot parallelism) ---
REDIS_URL=redis://localhost:6379/0

# --- MongoDB (stores pipeline run/result records) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_URL=mongodb://admin:changeme@localhost:27017
MONGO_DATABASE=pipeline

# --- MinIO (stores generated media objects) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=pipeline-artifacts
